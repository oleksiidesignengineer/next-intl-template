{
  "name": "next-intl-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "check:translations": "tsx scripts/check-translations.ts",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "^3.5.22",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "@swc/core": false,
    "esbuild": false,
    "fsevents": false,
    "unrs-resolver": false
  }
}
